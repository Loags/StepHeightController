.window-root {
    flex-grow: 1;
    background-color: rgb(20, 23, 32);
    color: rgb(228, 234, 246);
}
.window-scroll { flex-grow: 1; padding: 18px; }
.hero-card {
    flex-direction: row;
    align-items: center;
    padding: 18px;
    margin-bottom: 14px;
    background-color: rgb(11, 16, 32);
    border-width: 1px;
    border-top-color: rgb(46, 199, 238);
    border-left-color: rgb(46, 199, 238);
    border-right-color: rgb(114, 80, 230);
    border-bottom-color: rgb(114, 80, 230);
    border-radius: 14px;
}
.step-mark {
    flex-direction: row;
    align-items: flex-end;
    width: 58px;
    height: 54px;
    flex-shrink: 0;
    margin-right: 18px;
}
.step-bar { width: 14px; margin-right: 5px; border-radius: 4px; }
.step-low { height: 22px; background-color: rgb(46, 199, 238); }
.step-mid { height: 38px; background-color: rgb(77, 139, 238); }
.step-high { height: 54px; background-color: rgb(133, 104, 238); }
.hero-copy, .package-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.eyebrow { font-size: 10px; -unity-font-style: bold; color: rgb(101, 222, 247); margin-bottom: 5px; }
.hero-title { font-size: 23px; -unity-font-style: bold; color: rgb(239, 246, 255); white-space: normal; }
.section-card { padding: 16px; margin-bottom: 12px; background-color: rgb(29, 33, 45); border-radius: 12px; }
.heading-row { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; }
.section-title { font-size: 17px; -unity-font-style: bold; color: rgb(236, 241, 251); white-space: normal; }
.step-title, .package-name { font-size: 14px; -unity-font-style: bold; color: rgb(236, 241, 251); white-space: normal; }
.description { margin-top: 5px; white-space: normal; color: rgb(174, 185, 204); font-size: 12px; }
.hint, .controls { margin-top: 10px; white-space: normal; font-size: 11px; color: rgb(164, 177, 199); }
.controls { color: rgb(114, 211, 237); }
.status-ready { color: rgb(80, 220, 167); }
.status-action { color: rgb(255, 190, 92); }
.requirements { margin-top: 12px; }
.requirements > .unity-foldout__toggle { color: rgb(218, 225, 240); }
.requirements .unity-foldout__text { color: rgb(218, 225, 240); }
.requirements > .unity-foldout__content { margin-left: 0; padding-top: 10px; }
.package-row { flex-direction: row; align-items: center; padding: 10px; margin-top: 7px; background-color: rgb(23, 27, 38); border-radius: 8px; }
.package-row .description { margin-top: 2px; }
.settings-heading { margin-top: 16px; }
.button-row, .demo-row { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.demo-card { flex-grow: 1; flex-basis: 200px; min-width: 200px; margin: 5px 4px 0 0; padding: 12px; background-color: rgb(23, 27, 38); border-radius: 9px; }
.demo-description { min-height: 34px; }
.demo-card .button-row { flex-wrap: nowrap; }
.demo-card .button-row > Button { flex-grow: 1; flex-basis: 0; min-width: 0; padding-left: 5px; padding-right: 5px; }
.window-root Button {
    min-height: 30px;
    margin: 4px 6px 0 0;
    padding: 5px 12px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 7px;
    white-space: normal;
    transition-property: background-color;
    transition-duration: 0.12s;
}
.window-root .primary-button { background-color: rgb(84, 91, 230); color: rgb(255, 255, 255); -unity-font-style: bold; }
.window-root .secondary-button { background-color: rgb(43, 49, 65); color: rgb(218, 225, 240); }
.window-root .link-button { background-color: rgba(62, 201, 238, 0.12); color: rgb(102, 219, 246); }
.window-root Button:hover:enabled { background-color: rgb(65, 74, 102); }
.window-root .primary-button:hover:enabled { background-color: rgb(104, 110, 245); }
.window-root Button:disabled { opacity: 0.4; }
.window-root Button:focus { border-color: rgb(101, 222, 247); }
.player-field { margin-top: 12px; }
.player-field .unity-base-field__label { min-width: 55px; color: rgb(218, 225, 240); }
.player-field .unity-object-field__input { background-color: rgb(23, 27, 38); color: rgb(236, 241, 251); }
.player-field .unity-object-field__object { color: rgb(236, 241, 251); }
.setup-toggle { margin-top: 10px; }
.setup-toggle .unity-toggle__label { color: rgb(218, 225, 240); flex-shrink: 1; white-space: normal; }
.setup-toggle .unity-toggle__text { color: rgb(218, 225, 240); white-space: normal; margin-left: 6px; }
.setup-toggle .unity-toggle__input > .unity-toggle__checkmark { border-width: 1px; border-color: rgb(102, 118, 145); }
.preview-panel { padding: 12px; margin-top: 12px; margin-bottom: 8px; background-color: rgb(23, 27, 38); border-radius: 8px; }
