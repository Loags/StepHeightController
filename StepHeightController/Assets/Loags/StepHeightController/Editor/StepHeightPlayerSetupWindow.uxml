<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="StepHeightSetupWindow.uss" />
    <ui:VisualElement class="window-root">
        <ui:ScrollView class="window-scroll">
            <ui:VisualElement class="hero-card">
                <ui:VisualElement class="step-mark" picking-mode="Ignore">
                    <ui:VisualElement class="step-bar step-low" />
                    <ui:VisualElement class="step-bar step-mid" />
                    <ui:VisualElement class="step-bar step-high" />
                </ui:VisualElement>
                <ui:VisualElement class="hero-copy">
                    <ui:Label text="YOUR RIGIDBODY PLAYER" class="eyebrow" />
                    <ui:Label text="Add smooth stepping" class="hero-title" />
                    <ui:Label text="Choose a player. Review the changes. Apply when ready." class="description" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="section-card">
                <ui:Label text="1. Choose your player" class="section-title" />
                <ui:Label text="Select the player object in your scene, then use it below." class="description" />
                <ui:VisualElement name="playerFieldContainer" />
                <ui:VisualElement class="button-row">
                    <ui:Button name="selectionButton" text="Use selected object" class="secondary-button" />
                    <ui:Button name="refreshButton" text="Check again" class="secondary-button" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="section-card">
                <ui:Label text="2. Choose adjustments" class="section-title" />
                <ui:Label text="Optional improvements to Rigidbody motion." class="description" />
                <ui:Toggle name="smoothMovement" text="Smooth visual movement" class="setup-toggle" tooltip="Enable Rigidbody interpolation to smooth movement between physics updates." />
                <ui:Toggle name="keepUpright" text="Keep the player upright" class="setup-toggle" tooltip="Freeze Rigidbody rotation on X and Z. Existing constraints are preserved." />
            </ui:VisualElement>
            <ui:VisualElement class="section-card">
                <ui:Label text="3. Review &amp; apply" class="section-title" />
                <ui:Label name="previewLabel" class="description preview-panel" />
                <ui:Button name="applyButton" text="Apply changes" class="primary-button" />
                <ui:Label text="Supports Undo. Save your scene when you're happy." class="hint" />
            </ui:VisualElement>
            <ui:VisualElement class="section-card">
                <ui:Label text="Finish the movement connection" class="step-title" />
                <ui:Label text="Follow the quick start to connect your movement script. Your input and camera setup stay in place." class="description" />
                <ui:Button name="documentationButton" text="Open quick start" class="link-button" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
